@{
    ViewData["Title"] = "Welcome to Library System";
}

<div class="hero">
    <div class="hero-inner container">
        <div class="row align-items-center">
                <div class="col-lg-7">
                    <h1>Library System Management</h1>
                    <p class="lead">A clean, responsive library management app — catalog books, music and toys, process borrows/returns, and track fines.</p>

                    <div class="search-bar my-4">
                        <form asp-controller="Public" asp-action="Index" method="get">
                            <div class="input-group">
                                <input class="form-control" name="q" placeholder="Search the catalog (title, code, author or artist)" aria-label="Search" />
                                <button class="btn btn-primary" type="submit">Search</button>
                            </div>
                        </form>
                    </div>

                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                        <a class="btn btn-primary" asp-controller="Public" asp-action="Index">Browse Catalog</a>
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-flex align-items-center justify-content-center">
                    <div class="hero-visual text-center">
                        <div id="heroCarousel" class="carousel slide hero-carousel-frame" data-bs-ride="carousel" data-bs-interval="3500">
                            <div class="carousel-indicators hero-carousel-indicators">
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Books image 1"></button>
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Books image 2"></button>
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Music image 1"></button>
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="3" aria-label="Music image 2"></button>
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="4" aria-label="Toys image 1"></button>
                                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="5" aria-label="Toys image 2"></button>
                            </div>
                            <div class="carousel-inner rounded overflow-hidden hero-carousel-viewport">
                                <div class="carousel-item active">
                                    <img src="~/images/book1.jpg" class="d-block w-100 hero-carousel-image" alt="Books image 1" />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/book2.jpg" class="d-block w-100 hero-carousel-image" alt="Books image 2" />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/music1.jpg" class="d-block w-100 hero-carousel-image" alt="Music image 1" />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/music2.jpg" class="d-block w-100 hero-carousel-image" alt="Music image 2" />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/toy1.jpg" class="d-block w-100 hero-carousel-image" alt="Toys image 1" />
                                </div>
                                <div class="carousel-item">
                                    <img src="~/images/toy2.jpg" class="d-block w-100 hero-carousel-image" alt="Toys image 2" />
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Previous image">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Next image">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                        </div>
                        <h5 class="mt-3">Organize your collection</h5>
                        <p class="mb-0 text-muted-2">Create and manage books, music and toys with clear statuses and tracking.</p>
                    </div>
                </div>
        </div>
    </div>
</div>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Admin</h5>
                <p>Full CRUD for items with type-specific metadata (author, artist, toy age). Manage catalog codes and statuses.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Borrowing</h5>
                <p>Process borrows and returns, manage borrowers, and automatically calculate late fines.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Manager</h5>
                <p>View borrowing statistics, item status breakdowns and fine totals to help make decisions.</p>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-8">
            <div class="cta">
                <h4 class="mb-2">Ready to manage your library smarter?</h4>
                <p class="mb-3">Sign in with the demo accounts to explore Admin, Borrowing, and Manager workflows. For production, configure Identity users and secure credentials.</p>
                <div>
                    <a class="btn btn-light me-2" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                    <a class="btn btn-outline-light" asp-controller="Public" asp-action="Index">Try search</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Quick links</h5>
                <ul class="list-unstyled mb-0">
                    <li><a asp-controller="Admin" asp-action="Index">Admin area</a></li>
                    <li><a asp-controller="Reception" asp-action="Index">Borrowing area</a></li>
                    <li><a asp-controller="Manager" asp-action="Index">Manager area</a></li>
                    <li><a asp-controller="Public" asp-action="Index">Public search</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>