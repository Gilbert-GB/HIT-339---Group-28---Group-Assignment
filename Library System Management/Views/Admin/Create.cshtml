@{
    ViewData["Title"] = "Create Item";
}

<h2>Create Item</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Type</label>
        <select name="type" class="form-select">
            <option value="book">Book</option>
            <option value="music">Music</option>
            <option value="toy">Toy</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input name="name" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Library Code</label>
        <input name="libraryCode" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Author (books)</label>
        <input name="author" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Genre (books)</label>
        <input name="genre" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Pages (books)</label>
        <input name="pages" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label class="form-label">Artist (music)</label>
        <input name="artist" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Year (music)</label>
        <input name="year" class="form-control" type="number" />
    </div>
    <div class="mb-3">
        <label class="form-label">Format (music)</label>
        <input name="format" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Toy Type (toys)</label>
        <input name="toyType" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Recommended Age (toys)</label>
        <input name="recommendedAge" class="form-control" type="number" />
    </div>

    <button class="btn btn-primary">Create</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
