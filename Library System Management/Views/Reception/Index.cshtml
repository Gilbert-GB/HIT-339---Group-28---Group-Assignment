@model IEnumerable<Library_System_Management.Models.BorrowRecordViewModel>

@{
    ViewData["Title"] = "Reception - Borrow Records";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Borrow Records</h2>
    <div>
        <a class="btn btn-primary me-2" asp-action="Borrow">Borrow Item</a>
        <a class="btn btn-outline-secondary" asp-controller="Branches" asp-action="Index">Branches</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Code</th>
            <th>Borrower</th>
            <th>Borrower Username</th>
            <th>Borrowed At</th>
            <th>Due At</th>
            <th>Returned At</th>
            <th>Fine</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach(var r in Model)
    {
        <tr>
            <td>@r.ItemName</td>
            <td>@r.ItemCode</td>
            <td>@r.BorrowerName</td>
            <td>@(string.IsNullOrWhiteSpace(r.BorrowerUsername) ? "-" : r.BorrowerUsername)</td>
            <td>@r.BorrowedAt.ToLocalTime()</td>
            <td>@r.DueAt.ToLocalTime()</td>
            <td>@(r.ReturnedAt?.ToLocalTime().ToString() ?? "-")</td>
            <td>@r.FinePaid.ToString("C")</td>
            <td>
                @if(r.ReturnedAt == null)
                {
                    <a class="btn btn-sm btn-success" asp-action="Return" asp-route-id="@r.BorrowRecordId">Return</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
    </div>
    <div class="col-lg-3">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h6 class="card-title">Reception Quick Actions</h6>
                <div class="d-grid gap-2">
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-1"></i> Notifications</a>
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Branches" asp-action="Index"><i class="bi bi-arrow-left-right me-1"></i> Transfer</a>
                    <a class="btn btn-outline-info btn-sm" asp-controller="Reception" asp-action="Borrow"><i class="bi bi-plus-lg me-1"></i> New Borrow</a>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-body small">
                <h6 class="card-title">Tips</h6>
                <p class="mb-0">Use the Borrow button to register new borrows. Use Transfers to move items between branches.</p>
            </div>
        </div>
    </div>
</div>
