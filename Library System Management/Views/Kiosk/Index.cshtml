@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "Library Kiosk";
    var repo = (Library_System_Management.Repositories.ILibraryRepository?)ViewContext.HttpContext.RequestServices
        .GetService(typeof(Library_System_Management.Repositories.ILibraryRepository));
    var branchNames = repo?.GetAllBranches().ToDictionary(b => b.Id, b => b.Name) ?? new Dictionary<Guid, string>();
    var samples = repo?.GetAllItems()
        .Where(i => i.Status == Library_System_Management.Models.ItemStatus.Available)
        .Take(50)
        .ToList() ?? new List<Library_System_Management.Models.Item>();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10">

            <ul class="nav nav-tabs mb-3" id="kioskTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="lookup-tab" data-bs-toggle="tab" data-bs-target="#lookup" type="button" role="tab" aria-controls="lookup" aria-selected="true">My Account</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="browse-tab" data-bs-toggle="tab" data-bs-target="#browse" type="button" role="tab" aria-controls="browse" aria-selected="false">Browse Items</button>
                </li>
            </ul>

            @if (TempData["KioskError"] != null)
            {
                <div class="alert alert-danger">@TempData["KioskError"]</div>
            }
            @if (TempData["KioskSuccess"] != null)
            {
                <div class="alert alert-success">@TempData["KioskSuccess"]</div>
            }
            @if (ViewData["Message"] != null)
            {
                <div class="alert alert-info">@ViewData["Message"]</div>
            }

            <div class="tab-content" id="kioskTabContent">
                <div class="tab-pane fade show active" id="lookup" role="tabpanel" aria-labelledby="lookup-tab">
                    <div class="text-center">
                        <h2 class="mb-4">Welcome to the Library Kiosk</h2>
                        <p class="lead">Enter or scan your email or library username to see your account and borrow items.</p>
                        <form asp-controller="Kiosk" asp-action="Lookup" method="post" class="d-grid gap-2">
                            <input id="lookupInput" name="code" type="text" class="form-control form-control-lg kiosk-input"
                                   placeholder="Email or library username" autocomplete="off" inputmode="text" autofocus />
                            <button type="submit" class="btn btn-primary kiosk-btn">Continue</button>
                        </form>
                    </div>
                </div>

                <div class="tab-pane fade" id="browse" role="tabpanel" aria-labelledby="browse-tab">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Available items (tap to quick-checkout)</h5>
                            <div class="table-responsive">
                                <table id="samplesTable" class="table table-sm table-hover mb-0">
                                    <thead><tr><th>Code</th><th>Item</th><th>Type</th><th>Branch</th></tr></thead>
                                    <tbody>
                                        @foreach (var it in samples)
                                        {
                                            var branchName = it.BranchId.HasValue && branchNames.TryGetValue(it.BranchId.Value, out var bn) ? bn : "-";
                                            <tr class="sample-row" data-code="@it.LibraryCode" style="cursor: pointer;">
                                                <td><strong>@it.LibraryCode</strong></td>
                                                <td>@it.Name</td>
                                                <td>@it.GetType().Name</td>
                                                <td>@branchName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Quick-checkout modal -->
<div class="modal fade" id="quickCheckoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Quick Checkout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Kiosk" asp-action="CheckoutByIdentifier" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="modalItemCode">Item Code</label>
                        <input id="modalItemCode" name="itemCode" readonly class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="modalIdentifier">Your email or library username</label>
                        <input id="modalIdentifier" name="identifier" required class="form-control" placeholder="you@example.com or username" autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Checkout</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Tapping an item opens the quick-checkout modal with its code filled in.
    document.addEventListener('DOMContentLoaded', function () {
        var modalEl = document.getElementById('quickCheckoutModal');
        document.querySelectorAll('.sample-row').forEach(function (row) {
            row.addEventListener('click', function () {
                document.getElementById('modalItemCode').value = row.getAttribute('data-code');
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
        });
        modalEl.addEventListener('shown.bs.modal', function () {
            document.getElementById('modalIdentifier').focus();
        });
    });
</script>