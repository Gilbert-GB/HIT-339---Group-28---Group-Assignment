@model Library_System_Management.Models.KioskAccountViewModel
@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "Account Summary";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h3 class="mb-0">Hello, @Model.Borrower.FullName</h3>
            <p class="text-muted mb-0">@Model.Borrower.Email</p>
        </div>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Kiosk" asp-action="Index">Done</a>
    </div>
    <hr />

    @if (TempData["KioskSuccess"] != null)
    {
        <div class="alert alert-success">@TempData["KioskSuccess"]</div>
    }
    @if (TempData["KioskError"] != null)
    {
        <div class="alert alert-danger">@TempData["KioskError"]</div>
    }

    <div class="row g-3 mb-4 text-center">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">On loan</div>
                    <div class="fs-3 fw-semibold">@Model.Loans.Count</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100 @(Model.OverdueCount > 0 ? "border-danger" : "")">
                <div class="card-body">
                    <div class="small text-muted">Overdue</div>
                    <div class="fs-3 fw-semibold @(Model.OverdueCount > 0 ? "text-danger" : "")">@Model.OverdueCount</div>
                    @if (Model.FinesAccruing > 0)
                    {
                        <div class="small text-danger">@Model.FinesAccruing.ToString("C") accruing</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100 @(Model.FinesOwing > 0 ? "border-warning" : "")">
                <div class="card-body">
                    <div class="small text-muted">Fines owing</div>
                    <div class="fs-3 fw-semibold @(Model.FinesOwing > 0 ? "text-danger" : "")">@Model.FinesOwing.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted">Fines paid</div>
                    <div class="fs-3 fw-semibold">@Model.FinesPaid.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.OutstandingFines.Any())
    {
        <h5>Fines to pay</h5>
        <ul class="list-group mb-4">
            @foreach (var f in Model.OutstandingFines)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>
                        @f.Name <small class="text-muted">(@f.Code)</small>
                        <div class="small text-muted">Returned late on @f.ReturnedAt?.ToLocalTime().ToString("d")</div>
                    </span>
                    <a class="btn btn-warning" asp-controller="Kiosk" asp-action="Pay"
                       asp-route-borrowerId="@Model.Borrower.Id" asp-route-recordId="@f.RecordId">
                        Pay @f.Amount.ToString("C")
                    </a>
                </li>
            }
        </ul>
    }

    <h5>Borrow an item</h5>
    <form asp-controller="Kiosk" asp-action="Checkout" method="post" class="d-flex gap-2 mb-4">
        <input type="hidden" name="borrowerId" value="@Model.Borrower.Id" />
        <input name="itemCode" class="form-control form-control-lg" placeholder="Scan or type item code (e.g., B003)"
               autocomplete="off" autofocus />
        <button type="submit" class="btn btn-success btn-lg">Checkout</button>
    </form>

    <h5>Items on loan</h5>
    @if (!Model.Loans.Any())
    {
        <p class="text-muted">You have no items on loan.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-sm align-middle">
                <thead><tr><th>Code</th><th>Item</th><th>Branch</th><th>Due</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var loan in Model.Loans)
                    {
                        <tr class="@(loan.IsOverdue ? "table-danger" : "")">
                            <td>@loan.Code</td>
                            <td>@loan.Name</td>
                            <td>@loan.Branch</td>
                            <td>@loan.DueAt.ToLocalTime().ToString("d")</td>
                            <td>
                                @if (loan.IsOverdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                    <div class="small">@loan.DaysLate day(s) late, fine so far @loan.AccruingFine.ToString("C")</div>
                                }
                                else
                                {
                                    <span class="badge bg-success">On time</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h5>Reservations</h5>
    @if (!Model.Reservations.Any())
    {
        <p class="text-muted">You have no reservations.</p>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var r in Model.Reservations)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@r.Name <small class="text-muted">(@r.Code)</small></span>
                    <span class="badge @(r.IsReady ? "bg-success" : "bg-secondary")">@r.Status</span>
                </li>
            }
        </ul>
    }

    <h5>Recent returns</h5>
    @if (!Model.RecentReturns.Any())
    {
        <p class="text-muted">No returns yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead><tr><th>Code</th><th>Item</th><th>Returned</th><th>Fine</th></tr></thead>
                <tbody>
                    @foreach (var h in Model.RecentReturns)
                    {
                        <tr>
                            <td>@h.Code</td>
                            <td>@h.Name</td>
                            <td>@h.ReturnedAt?.ToLocalTime().ToString("d")</td>
                            <td>
                                @if (h.FineAmount <= 0)
                                {
                                    <span>-</span>
                                }
                                else if (h.FineSettled)
                                {
                                    <span>@h.FineAmount.ToString("C") <span class="badge bg-success">Paid</span></span>
                                }
                                else
                                {
                                    <span class="text-danger">@h.FineAmount.ToString("C") <span class="badge bg-warning text-dark">Owing</span></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="small text-muted mt-4 mb-0">For privacy, this screen returns to the start after 90 seconds of inactivity.</p>
</div>

<script>
    // Return to the kiosk start screen after 90 seconds of inactivity so the next
    // patron cannot see this account.
    (function () {
        var timeoutMs = 90000;
        var timer;
        function reset() {
            clearTimeout(timer);
            timer = setTimeout(function () {
                window.location.href = '@Url.Action("Index", "Kiosk")';
            }, timeoutMs);
        }
        ['click', 'keydown', 'touchstart', 'mousemove'].forEach(function (evt) {
            document.addEventListener(evt, reset, { passive: true });
        });
        reset();
    })();
</script>