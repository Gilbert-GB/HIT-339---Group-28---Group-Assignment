@model IEnumerable<Library_System_Management.Models.BorrowRecord>
@{
    Layout = "_KioskLayout";
    ViewData["Title"] = "Account Summary";
    var borrower = (Library_System_Management.Models.Borrower?)ViewData["Borrower"];
}

<div class="container py-4">
    <div class="row">
        <div class="col-12">
            <h3>Account: @borrower?.FullName</h3>
            <p class="text-muted">@borrower?.Email</p>
            <hr />

            <h5>Outstanding Items</h5>
            <table class="table table-striped table-sm">
                <thead><tr><th>Code</th><th>Item</th><th>Due</th></tr></thead>
                <tbody>
                @foreach(var r in Model)
                {
                    var item = ViewContext.HttpContext.RequestServices.GetService(typeof(Library_System_Management.Repositories.ILibraryRepository)) as Library_System_Management.Repositories.ILibraryRepository;
                    var it = item?.GetItem(r.ItemId);
                    <tr>
                        <td>@(it?.LibraryCode ?? "-")</td>
                        <td>@(it?.Name ?? "-")</td>
                        <td>@r.DueAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
                </tbody>
            </table>

            <h5>Borrow an item</h5>
            <form method="post" action="/Kiosk/Checkout" class="d-flex gap-2">
                <input type="hidden" name="borrowerId" value="@borrower?.Id" />
                <input name="itemCode" class="form-control form-control-lg" placeholder="Item code (e.g., B001)" />
                <button class="btn btn-success btn-lg">Checkout</button>
            </form>

            <div class="mt-3">
                <a class="btn btn-link" href="/">Return to catalog</a>
            </div>
        </div>
    </div>
</div>
