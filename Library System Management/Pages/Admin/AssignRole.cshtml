@page
@model Library_System_Management.Pages.Admin.AssignRoleModel
@{
    ViewData["Title"] = "Manage Users / Roles";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Manage Users / Roles</h2>
            <p class="text-muted mb-0">Assign or remove roles for existing Identity users.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">Back to Admin</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Assign or remove a role</h5>
                    <form method="post" class="mt-3">
                        <div class="mb-3">
                            <label class="form-label">User</label>
                            <select class="form-select" asp-for="SelectedUserId">
                                <option value="">Select a user</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id">@user.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select class="form-select" asp-for="SelectedRole">
                                <option value="">Select a role</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="submit" name="ActionType" value="add">Add role</button>
                            <button class="btn btn-outline-danger" type="submit" name="ActionType" value="remove">Remove role</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Current users</h5>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Confirmed</th>
                                    <th>Roles</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td>@user.DisplayName</td>
                                        <td>@(user.EmailConfirmed ? "Yes" : "No")</td>
                                        <td>@(user.Roles.Any() ? string.Join(", ", user.Roles) : "No roles assigned")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
