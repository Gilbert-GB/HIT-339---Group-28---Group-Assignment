@model dynamic

@{
    ViewData["Title"] = "Manager - Statistics";
}

<h2>Library Statistics</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Items</h5>
                <p>Total: @Model.TotalItems</p>
                <p>Available: @Model.Available</p>
                <p>Borrowed: @Model.Borrowed</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Borrowing</h5>
                <p>Total borrows: @Model.TotalBorrows</p>
                <p>Outstanding: @Model.OutstandingBorrows</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Fines</h5>
                <p>Total fines collected: @Model.TotalFinesCollected</p>
            </div>
        </div>
    </div>
</div>
