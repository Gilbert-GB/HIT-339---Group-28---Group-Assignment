@{
    ViewData["Title"] = "Welcome to Library System";
}

<div class="hero">
    <div class="hero-inner container">
        <div class="row align-items-center">
                <div class="col-lg-7">
                    <h1>Library System Management</h1>
                    <p class="lead">A clean, responsive library management app — catalog books, music and toys, process borrows/returns, and track fines.</p>

                    <div class="search-bar my-4">
                        <form asp-controller="Public" asp-action="Index" method="get">
                            <div class="input-group">
                                <input class="form-control" name="q" placeholder="Search the catalog (title, code, description)" aria-label="Search" />
                                <button class="btn btn-primary" type="submit">Search</button>
                            </div>
                        </form>
                    </div>

                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-primary" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                        <a class="btn btn-primary" asp-controller="Public" asp-action="Index">Browse Catalog</a>
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <img src="~/images/library-illustration.svg" alt="Library" class="img-fluid" style="max-width:260px;" />
                        <h5 class="mt-3">Organize your collection</h5>
                        <p class="mb-0 text-muted-2">Create and manage books, music and toys with clear statuses and tracking.</p>
                    </div>
                </div>
        </div>
    </div>
</div>

<section class="container py-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Admin</h5>
                <p>Full CRUD for items with type-specific metadata (author, artist, toy age). Manage catalog codes and statuses.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Borrowing</h5>
                <p>Process borrows and returns, manage borrowers, and automatically calculate late fines.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Manager</h5>
                <p>View borrowing statistics, item status breakdowns and fine totals to help make decisions.</p>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-8">
            <div class="cta">
                <h4 class="mb-2">Ready to manage your library smarter?</h4>
                <p class="mb-3">Sign in with the demo accounts to explore Admin, Borrowing, and Manager workflows. For production, configure Identity users and secure credentials.</p>
                <div>
                    <a class="btn btn-light me-2" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
                    <a class="btn btn-outline-light" asp-controller="Public" asp-action="Index">Try search</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <h5>Quick links</h5>
                <ul class="list-unstyled mb-0">
                    <li><a asp-controller="Admin" asp-action="Index">Admin area</a></li>
                    <li><a asp-controller="Reception" asp-action="Index">Borrowing area</a></li>
                    <li><a asp-controller="Manager" asp-action="Index">Manager area</a></li>
                    <li><a asp-controller="Public" asp-action="Index">Public search</a></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<footer class="footer mt-auto">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <strong>Library System Management</strong> — built with ASP.NET Core
        </div>
        <div>
            <small>&copy; 2026 Library System</small>
        </div>
    </div>
</footer>
